# Copy to .env.local and fill in. Add the same variables in Vercel →
# Project → Settings → Environment Variables.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend email notifications (optional) ---
# Leave RESEND_API_KEY empty to turn emails off. Messages are still saved.
RESEND_API_KEY=
# Defaults to "Marketplace <onboarding@resend.dev>" (Resend's test sender).
RESEND_FROM_EMAIL=
# Send every notification to this inbox instead of the seller (free-tier demo mode).
RESEND_DEMO_RECIPIENT=

# --- Stripe Connect (sandbox keys from the brief) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only. Never commit it.
STRIPE_SECRET_KEY=sk_test_...
# From scripts/create-webhook.mjs (production) or `stripe listen` (local)
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee kept from each sale (default 10)
PLATFORM_FEE_PERCENT=10
